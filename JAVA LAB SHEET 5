class PrimeChecker {
    static int totalPrimeChecks = 0;

    void checkPrime(int num) {
        totalPrimeChecks++;
        int localNum = num;
        boolean isPrime = true;

        if (localNum <= 1) {
            isPrime = false;
        } else {
            for (int i = 2; i <= Math.sqrt(localNum); i++) {
                if (localNum % i == 0) {
                    isPrime = false;
                    break;
                }
            }
        }

        if (isPrime) {
            System.out.println(localNum + " is Prime.");
        } else {
            System.out.println(localNum + " is NOT Prime.");
        }
        System.out.println("Total Prime Checks: " + totalPrimeChecks);
    }
}

